APP_DOMAIN=erp.midominio.com
PUBLIC_DOMAIN=midominio.com
PUBLIC_WWW_DOMAIN=www.midominio.com
VITE_ERP_APP_URL=https://erp.midominio.com
VITE_PUBLIC_APP_URL=https://midominio.com
VITE_API_URL=/api
CORS_ALLOWED_ORIGINS=https://erp.midominio.com,https://midominio.com

DB_HOST=db
DB_PORT=5432
DB_NAME=grimorio_prod
DB_USER=grimorio
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

JWT_SECRET_KEY=CHANGE_ME_SUPER_LONG_RANDOM_SECRET
JWT_ISSUER=Grimorio
JWT_AUDIENCE=GrimorioClient
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=480

GRIMORIO_ADMIN_EMAIL=admin@midominio.com
GRIMORIO_ADMIN_PASSWORD=CHANGE_ME_INITIAL_ADMIN_PASSWORD

ALEXA_KITCHEN_COMMAND_KEY=CHANGE_ME_ALEXA_KITCHEN_COMMAND_KEY

FIREBASE_SERVICE_ACCOUNT_PATH=/app/secrets/firebase-adminsdk.json
DATA_PROTECTION_KEYS_PATH=/app/keys

# Optional walkie-talkie overlay: docker-compose.voice.yml
# Point this DNS record directly to the VPS (not an HTTP-only CDN proxy).
VOICE_DOMAIN=voz.elcalderoflameante.com
VOICE_API_KEY=CHANGE_ME_VOICE_API_KEY
VOICE_API_SECRET=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_BYTES
VOICE_MEMORY_LIMIT=512m

# Loyalty WhatsApp: enable only after linking Meta and confirming coexistence.
LOYALTY_WHATSAPP_ENABLED=false
LOYALTY_WHATSAPP_MODE=Production
LOYALTY_WHATSAPP_BRANCH_ID=00000000-0000-0000-0000-000000000000
LOYALTY_WHATSAPP_META_APP_ID=2240696883514460
LOYALTY_WHATSAPP_PHONE_NUMBER_ID=
LOYALTY_WHATSAPP_BUSINESS_ACCOUNT_ID=
LOYALTY_WHATSAPP_BUSINESS_PHONE=+593964135806
LOYALTY_WHATSAPP_ACCESS_TOKEN=
LOYALTY_WHATSAPP_AUTHENTICATION_TEMPLATE=caldero_codigo_fidelizacion
LOYALTY_WHATSAPP_TEMPLATE_LANGUAGE=es
LOYALTY_WHATSAPP_GRAPH_VERSION=v25.0
LOYALTY_WHATSAPP_RESTRICT_RECIPIENTS=true
LOYALTY_WHATSAPP_ALLOWED_PHONE_1=
LOYALTY_WHATSAPP_ALLOWED_PHONE_2=
LOYALTY_WHATSAPP_DAILY_SEND_LIMIT=100
LOYALTY_WHATSAPP_COEXISTENCE_CONFIRMED=false
LOYALTY_WHATSAPP_CODE_HASH_KEY=
LOYALTY_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
LOYALTY_WHATSAPP_APP_SECRET=
